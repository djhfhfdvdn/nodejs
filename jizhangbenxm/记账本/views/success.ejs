<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>添加成功</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Microsoft Yahei", sans-serif;
    }
    body {
      background-color: #fff;
      padding: 50px;
    }
    .success-box {
      background-color: #d4edda;
      color: #155724;
      padding: 24px;
      border-radius: 6px;
      border: 1px solid #c3e6cb;
      width: 90%;
      max-width: 800px;
    }
    .success-box h2 {
      font-size: 24px;
      margin-bottom: 8px;
    }
    .success-box p {
      font-size: 14px;
      color: #6c757d;
    }
  </style>
</head>
<body>
  <div class="success-box">
    <h2>:) <%= msg %> </h2>
    <p><a href="<%= url %>">点击跳转</a></p >
  </div>

  <!-- 可选：自动跳转脚本，和你之前逻辑一致 -->
  <!-- <script>
    setTimeout(() => {
      location.href = '/account';
    }, 1500);
  </script> -->
</body>
</html>