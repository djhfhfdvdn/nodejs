<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>登陆</title>
    <style>
        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body{
            padding: 80px;
        }
        .box{
            width: 300px;
            margin: 0 auto;
        }
        h1{
            text-align: center;
            font-size:28px;
            margin-bottom:30px;
            font-weight:normal;
        }
        .item{
            margin-bottom:16px;
        }
        label{
            display:block;
            font-size:14px;
            margin-bottom:4px;
        }
        input{
            width:100%;
            height:32px;
            padding:0 6px;
            border:1px solid #ccc;
        }
        button{
            width:100%;
            height:36px;
            background-color:#2478b5;
            color:#fff;
            border:none;
            cursor:pointer;
            font-size:14px;
        }
    </style>
</head>
<body>
    <div class="box">
        <h1>登陆</h1>
        <form method="post" action="/login">
            <div class="item">
                <label>用户名</label>
                <input type="text" name="username">
            </div>
            <div class="item">
                <label>密码</label>
                <input type="password" name="password">
            </div>
            <button type="submit">登录</button>
        </form>
    </div>
</body>
</html>